# TeamDynamix MCP Server Configuration

# Required: TDX instance base URL
TDX_BASE_URL=https://yourschool.teamdynamix.com

# Required: Admin service account credentials (from TDAdmin)
TDX_BEID=your-beid-guid-here
TDX_WEB_SERVICES_KEY=your-web-services-key-guid-here

# Optional: Application IDs (get from TDAdmin)
TDX_TICKETING_APP_ID=
TDX_ASSETS_APP_ID=
TDX_KB_APP_ID=

# Transport: stdio (default) or http
TDX_MCP_TRANSPORT=stdio
TDX_MCP_HTTP_PORT=3000
TDX_MCP_HTTP_HOST=0.0.0.0

# Logging: debug, info, warn, error
TDX_LOG_LEVEL=info

# Domains to pre-load at startup (comma-separated)
TDX_PRELOAD_DOMAINS=tickets

# Rate limit buffer (reserve this many slots as headroom)
TDX_RATE_LIMIT_BUFFER=5

# Privileged people writes (security role, active status, group membership).
# Off by default. These are refused in code even for an attributed caller unless
# this is set to "true". Keep the TDX service account on a least-privilege role
# regardless (defense in depth).
TDX_ALLOW_PRIVILEGED_PEOPLE_WRITES=false
