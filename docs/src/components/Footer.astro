---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="border-t border-navy/30 [:root:not(.dark)_&]:border-gray-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div>
        <h3 class="text-sm font-semibold text-gray-300 [:root:not(.dark)_&]:text-navy uppercase tracking-wider mb-3 font-heading">Getting Started</h3>
        <ul class="space-y-2">
          <li><a href={`${base}/getting-started/introduction`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">Introduction</a></li>
          <li><a href={`${base}/getting-started/installation`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">Installation</a></li>
          <li><a href={`${base}/getting-started/configuration`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">Configuration</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-300 [:root:not(.dark)_&]:text-navy uppercase tracking-wider mb-3 font-heading">Guides</h3>
        <ul class="space-y-2">
          <li><a href={`${base}/guides/claude`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">Using with Claude</a></li>
          <li><a href={`${base}/guides/docker`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">Docker Deployment</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-300 [:root:not(.dark)_&]:text-navy uppercase tracking-wider mb-3 font-heading">Reference</h3>
        <ul class="space-y-2">
          <li><a href={`${base}/reference/tools`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">All Tools</a></li>
          <li><a href={`${base}/reference/environment`} class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">Environment Variables</a></li>
          <li><a href="https://github.com/chatt-state/teamdynamix-mcp-server" class="text-sm text-gray-400 hover:text-highlight [:root:not(.dark)_&]:text-gray-500 [:root:not(.dark)_&]:hover:text-accent no-underline transition-colors">GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-navy/30 [:root:not(.dark)_&]:border-gray-200 text-center text-sm text-gray-500">
      &copy; {year} Chattanooga State Community College. MIT License.
    </div>
  </div>
</footer>
