---
interface Props {
  type?: "tip" | "caution" | "note";
}

const { type = "note" } = Astro.props;

const styles: Record<string, { border: string; bg: string; icon: string; label: string }> = {
  tip: {
    border: "border-green-600",
    bg: "bg-green-900/20 [:root:not(.dark)_&]:bg-green-50",
    icon: "💡",
    label: "Tip",
  },
  caution: {
    border: "border-amber-600",
    bg: "bg-amber-900/20 [:root:not(.dark)_&]:bg-amber-50",
    icon: "⚠️",
    label: "Caution",
  },
  note: {
    border: "border-blue-600",
    bg: "bg-blue-900/20 [:root:not(.dark)_&]:bg-blue-50",
    icon: "ℹ️",
    label: "Note",
  },
};

const s = styles[type];
---

<div class={`not-prose my-6 rounded-lg border-l-4 ${s.border} ${s.bg} p-4`}>
  <p class="font-semibold text-sm mb-1">
    <span class="mr-1">{s.icon}</span> {s.label}
  </p>
  <div class="text-sm text-gray-300 [:root:not(.dark)_&]:text-gray-700 [&>p]:m-0">
    <slot />
  </div>
</div>
