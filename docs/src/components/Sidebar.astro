---
const base = import.meta.env.BASE_URL;

const sections = [
  {
    title: "Getting Started",
    links: [
      { label: "Introduction", href: `${base}/getting-started/introduction` },
      { label: "Installation", href: `${base}/getting-started/installation` },
      { label: "Configuration", href: `${base}/getting-started/configuration` },
    ],
  },
  {
    title: "Guides",
    links: [
      { label: "Using with Claude", href: `${base}/guides/claude` },
      { label: "Claude Plugin", href: `${base}/guides/plugin` },
      { label: "Docker Deployment", href: `${base}/guides/docker` },
    ],
  },
  {
    title: "Reference",
    links: [
      { label: "All Tools", href: `${base}/reference/tools` },
      { label: "Environment Variables", href: `${base}/reference/environment` },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="w-full lg:w-56 shrink-0 text-sm lg:pr-6">
  <div class="lg:sticky lg:top-24 space-y-6">
    {sections.map((section) => (
      <div>
        <h4 class="font-heading font-semibold text-xs uppercase tracking-wider text-gray-400 [:root:not(.dark)_&]:text-navy/70 mb-2">
          {section.title}
        </h4>
        <ul class="space-y-1">
          {section.links.map(({ label, href }) => {
            const isActive = currentPath === href.replace(/\/$/, "");
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    "block px-3 py-1.5 rounded-md no-underline transition-colors",
                    isActive
                      ? "bg-highlight/15 text-highlight font-medium border-l-2 border-highlight [:root:not(.dark)_&]:bg-accent/10 [:root:not(.dark)_&]:text-accent [:root:not(.dark)_&]:border-accent"
                      : "text-gray-400 hover:text-highlight hover:bg-navy/40 [:root:not(.dark)_&]:text-gray-600 [:root:not(.dark)_&]:hover:text-accent [:root:not(.dark)_&]:hover:bg-gray-50",
                  ]}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>
