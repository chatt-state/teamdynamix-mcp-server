{
  "name": "teamdynamix",
  "version": "0.1.0",
  "description": "TeamDynamix ITSM integration — manage tickets, assets, people, and knowledge base articles via MCP tools",
  "author": "Aaron Sachs / Chattanooga State Community College",
  "homepage": "https://github.com/chatt-state/teamdynamix-mcp-server",
  "skills": [
    "skills/navigation",
    "skills/tickets",
    "skills/assets",
    "skills/people",
    "skills/knowledge-base"
  ],
  "commands": [
    "commands/start.md"
  ],
  "mcpServers": {
    "teamdynamix": {
      "command": "npx",
      "args": ["-y", "--registry", "https://npm.pkg.github.com", "@chatt-state/teamdynamix-mcp-server"],
      "env": {
        "TDX_BASE_URL": "",
        "TDX_BEID": "",
        "TDX_WEB_SERVICES_KEY": "",
        "TDX_TICKETING_APP_ID": "",
        "TDX_ASSETS_APP_ID": "",
        "TDX_KB_APP_ID": ""
      }
    }
  }
}
